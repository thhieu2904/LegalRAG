# Docker Environment Variables
# Browser calls backend services directly via exposed ports

# ============= API CONFIGURATION =============
VITE_API_BASE_URL=http://localhost:8001
VITE_ADMIN_SERVICE_URL=http://localhost:8001
VITE_QUERY_SERVICE_URL=http://localhost:8002
VITE_FORM_SERVICE_URL=http://localhost:8015
VITE_STORAGE_SERVICE_URL=http://localhost:8010

# ============= APP CONFIGURATION =============
VITE_APP_TITLE=LegalRAG System

# ============= FILE UPLOAD =============
# Maximum file size in bytes (10MB)
VITE_MAX_FILE_SIZE=10485760
