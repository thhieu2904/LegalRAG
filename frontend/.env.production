# Production Environment Variables for Vercel
# Copy these to Vercel Dashboard → Environment Variables

# ============= API CONFIGURATION =============
# Production API endpoints (configure based on your infrastructure)
VITE_API_BASE_URL=https://api.yourdomain.com/admin
VITE_ADMIN_SERVICE_URL=https://api.yourdomain.com/admin
VITE_QUERY_SERVICE_URL=https://api.yourdomain.com/query
VITE_FORM_SERVICE_URL=https://api.yourdomain.com/forms
VITE_STORAGE_SERVICE_URL=https://api.yourdomain.com/storage

# ============= APP CONFIGURATION =============
VITE_APP_TITLE=AI Center RAG

# ============= FILE UPLOAD =============
# Maximum file size in bytes (50MB)
VITE_MAX_FILE_SIZE=52428800
