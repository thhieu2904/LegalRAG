# ============================================
# LLM Service Configuration - Multi-Provider
# ============================================
# Copy this to .env and adjust values

# Service Configuration
SERVICE_NAME=llm-service
SERVICE_PORT=8006
SERVICE_HOST=0.0.0.0

# ============================================
# PROVIDER SELECTION
# ============================================
# Choose LLM backend:
# - "local" → Vistral 7B with llama-cpp-python (requires GPU)
# - "gemini" → Google Gemini API (no GPU required)
LLM_PROVIDER=local

# ============================================
# GEMINI PROVIDER CONFIGURATION
# ============================================
# Required if LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Get API key from: https://ai.google.dev/

# Gemini Model Selection
GEMINI_MODEL=gemini-2.5-flash-lite
# Options: gemini-2.5-flash-lite, gemini-2.0-flash, gemini-1.5-pro

# Gemini Generation Parameters
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9
GEMINI_TOP_K=40
GEMINI_MAX_TOKENS=4096

# ============================================
# LOCAL PROVIDER CONFIGURATION (Vistral 7B)
# ============================================
# Model Configuration
MODEL_NAME=ggml-vistral-7B-chat-q4_0.gguf
MODEL_PATH=/app/models/ggml-vistral-7B-chat-q4_0.gguf
MODEL_CACHE_DIR=/app/models

# HuggingFace Download (for initial setup)
HF_MODEL_REPO=uonlp/Vistral-7B-Chat-gguf
HF_MODEL_FILE=ggml-vistral-7B-chat-q4_0.gguf

# Llama.cpp Configuration
N_CTX=8192
# Context window size - Vistral supports up to 8K tokens
N_GPU_LAYERS=-1
# -1 = use all GPU layers, 0 = CPU only, >0 = specific number of layers
N_THREADS=4
# CPU threads to use (only if not using GPU)
N_BATCH=512
# Batch size for prompt processing

# Generation Parameters (shared between providers)
MAX_TOKENS=2048
# Maximum tokens to generate
TEMPERATURE=0.7
# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TOP_P=0.9
# Nucleus sampling threshold
TOP_K=40
# Top-K sampling
REPEAT_PENALTY=1.1
# Penalty for repeating tokens

# Hardware Configuration
DEVICE=cuda
# 'cuda' for GPU, 'cpu' for CPU-only
# Set to 'cpu' if no GPU available

# Performance Tuning
USE_MMAP=true
# Memory-map model file for faster loading
USE_MLOCK=false
# Lock model in RAM (requires sufficient memory)
VERBOSE=false
# Enable verbose llama.cpp logging

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
