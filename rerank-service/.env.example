# ============================================
# Rerank Service Configuration
# ============================================
# Copy this to .env and adjust values

# Service Configuration
SERVICE_NAME=rerank-service
SERVICE_PORT=8013
SERVICE_HOST=0.0.0.0

# Model Configuration
MODEL_NAME=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=/app/models
MODEL_MAX_LENGTH=1024

# Hardware Configuration
DEVICE=cpu
# Set to 'cuda' if GPU available for faster reranking
# DEVICE=cuda

# Inference Configuration
BATCH_SIZE=32
# Increase batch size for GPU: 64-128
TOP_K=5
# Number of top results to return after reranking

# Security
API_KEY_ENABLED=false
# Set to 'true' in production
API_KEY=rerank-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
