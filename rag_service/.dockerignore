# Add Docker ignore patterns for RAG service
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
.tox
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log

# Exclude large model files - will be downloaded at runtime
data/models/
.git
.gitignore
README.md
Dockerfile
.docker
.pytest_cache
.vscode
.idea
# data/cache/*  # Allow cache files for production
data/models/*  # Models too large for image, download on first run  
# data/storage/*  # Allow storage data for production
!data/cache/.gitkeep
!data/models/.gitkeep
!data/storage/.gitkeep