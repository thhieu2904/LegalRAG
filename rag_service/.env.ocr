# OCR Service Environment Variables

# Redis Configuration
OCR_REDIS_HOST=localhost
OCR_REDIS_PORT=6380
OCR_REDIS_DB=1
OCR_REDIS_PASSWORD=
OCR_REDIS_SSL=false

# Session Configuration  
OCR_SESSION_EXPIRY_HOURS=1
OCR_MAX_SESSIONS_PER_IP=5
OCR_CLEANUP_INTERVAL_MINUTES=30

# Image Configuration
OCR_MAX_IMAGE_SIZE_MB=10
OCR_ALLOWED_IMAGE_FORMATS=["jpeg", "jpg", "png", "webp"]
OCR_IMAGE_QUALITY=85
OCR_MAX_IMAGE_DIMENSIONS=4096

# OCR Configuration
OCR_VIETOCR_CONFIG=vgg_transformer
OCR_VIETOCR_DEVICE=cpu
OCR_OCR_CONFIDENCE_THRESHOLD=0.7
OCR_TEXT_DETECTION_CONFIDENCE=0.8

# Processing Configuration
OCR_MAX_PROCESSING_TIME_SECONDS=30
OCR_MAX_CONCURRENT_PROCESSES=3
OCR_ENABLE_PREPROCESSING=true
OCR_ENABLE_POSTPROCESSING=true

# Security Configuration
OCR_ENABLE_RATE_LIMITING=true
OCR_RATE_LIMIT_REQUESTS_PER_MINUTE=10
OCR_ENABLE_IP_WHITELIST=false
OCR_ALLOWED_IPS=[]

# Logging Configuration
OCR_LOG_LEVEL=INFO
OCR_ENABLE_OCR_LOGS=true
OCR_LOG_FILE_PATH=

# Development Configuration
OCR_DEBUG_MODE=true
OCR_SAVE_DEBUG_IMAGES=false
OCR_DEBUG_IMAGE_PATH=./debug_images

# Performance Configuration
OCR_ENABLE_CACHING=true
OCR_CACHE_TTL_SECONDS=3600
OCR_PRELOAD_MODELS=true
