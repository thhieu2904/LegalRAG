# ===================================================================
# LegalRAG Production Configuration
# ===================================================================
# Đây là file config production cho user cuối sử dụng
# Copy file này thành .env trong rag_service/ folder

# ===================================================================
# VRAM Management - QUAN TRỌNG: Chọn mode phù hợp với GPU
# ===================================================================
# ENABLE_VRAM_SWAPPING: Cơ chế quản lý VRAM
# true = Laptop/GPU yếu (6GB VRAM) - models load theo nhu cầu
# false = Desktop/Server (12GB+ VRAM) - models load cố định, hiệu suất cao
ENABLE_VRAM_SWAPPING=false

# ===================================================================
# AI Model Configuration
# ===================================================================
# MAX_TOKENS: Số token tối đa sinh ra (1200 = ~4800 chars)
MAX_TOKENS=1200

# TEMPERATURE: Độ sáng tạo (0.1 = chính xác cao cho pháp luật)
TEMPERATURE=0.1

# CONTEXT_LENGTH & N_CTX: Kích thước context window
CONTEXT_LENGTH=5888
N_CTX=5888

# N_GPU_LAYERS: Số layers chạy trên GPU (-1 = auto-detect)
N_GPU_LAYERS=-1

# ===================================================================
# Server Configuration
# ===================================================================
# DEBUG: Tắt debug mode cho production
DEBUG=false

# HOST & PORT: Địa chỉ server
HOST=0.0.0.0
PORT=8000

# ===================================================================
# Performance Settings
# ===================================================================
# TOP_K & TOP_P: Cài đặt generation
TOP_K=30
TOP_P=0.8

# K_DOCUMENTS: Số documents retrieve
K_DOCUMENTS=30

# SIMILARITY_THRESHOLD: Ngưỡng độ tương đồng
SIMILARITY_THRESHOLD=0.35

# ===================================================================
# System Settings
# ===================================================================
# LOG_LEVEL: Mức độ logging
LOG_LEVEL=INFO

# ENABLE_CORS: Bật CORS cho frontend
ENABLE_CORS=true

# CORS_ORIGINS: Allowed origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ===================================================================
# Model Paths (Docker paths - KHÔNG THAY ĐỔI)
# ===================================================================
LLM_MODEL_PATH=/app/data/models/llm_dir/PhoGPT-4B-Chat-Q4_K_M.gguf
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding_v2
RERANKER_MODEL_NAME=AITeamVN/Vietnamese_Reranker
VECTOR_DB_PATH=/app/data/vectordb
DOCUMENTS_PATH=/app/data/documents
STORAGE_PATH=/app/data/storage
